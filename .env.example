# UDITO — provider credentials and service URLs.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file (.env.example)
# is the only one committed. Rotate any credential that has lived in git
# history before using it.
#
# Loaded by src/audio/*.py via python-dotenv (see watsonAPI.py, StT.py, TtS.py).

# ---------- IBM watsonx.ai (LLM, used by watsonAPI.py and watson_dialog_manager) ----------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_REGION=eu-de

# ---------- IBM Watson Speech-to-Text (optional; Whisper is the default STT) ----------
WATSON_STT_API_KEY=
WATSON_STT_URL=

# ---------- IBM Watson Text-to-Speech (optional; Coqui is the default TTS) ----------
WATSON_TTS_API_KEY=
WATSON_TTS_URL=

# ---------- IBM Watson Assistant (exploratory only; src_tests/IBM/) ----------
WATSON_ASSISTANT_API_KEY=

# ---------- OpenAI (exploratory only; src_tests/openAI/) ----------
OPENAI_API_KEY=
